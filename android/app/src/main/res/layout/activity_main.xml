<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="電車チェック"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="WebアプリのURLを入れると、そこにある timetable.json を取得します（その後も6時間ごとに自動で取り直します）。空のままならアプリ同梱の時刻表を使います。" />
        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="https://ユーザー名.github.io/リポジトリ名/"
            android:inputType="textUri"
            android:importantForAutofill="no" />
        <Button
            android:id="@+id/fetch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存して時刻表を取得" />
        <Button
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ウィジェットを追加（1ルートずつ切り替え）" />
        <Button
            android:id="@+id/pinAll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ウィジェットを追加（全ルートを表示）" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="置いたあとも、ウィジェット右上のボタンで「1ルートずつ」と「全ルート」を切り替えられます。全ルート表示は、ウィジェットを縦に大きく（4×3 以上）すると種別つきの2行表示になります。"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
